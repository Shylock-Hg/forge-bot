# Secrets for forge-bot, referenced by contrib/forge-bot.service.
#
#   sudo install -Dm600 -o agent -g agent \
#       contrib/forge-bot.env.example /etc/forge-bot/forge-bot.env
#
# Values here override the corresponding keys in forge-bot.toml.

FORGEJO_BASE_URL=http://127.0.0.1:3000
FORGEJO_BOT_USERNAME=shylock-bot

# Bot access token (write:issue, write:repository).
FORGEJO_TOKEN=change-me

# Shared secret registered on the Forgejo webhook (openssl rand -hex 32).
FORGEJO_WEBHOOK_SECRET=change-me

# Default agent (codex is the first choice, e.g. pi-rpc is also available).
FORGE_BOT_DEFAULT_AGENT=codex
