# Example configuration for a per-user forge-bot install.
#
# `~` is expanded against $HOME. State and workspaces live under the user's
# home so the service can never reach system-wide state or another account.

bind = "127.0.0.1:8080"
mention = "@agent"
# Codex is the first choice; switch to "pi-rpc" for the long-lived pool.
default_agent = "codex"

[forgejo]
base_url = "http://127.0.0.1:3000"
# webhook_secret = "change-me"
# token = "change-me"
bot_username = "forge-bot"

[policy]
allowed_users = ["admin"]
allowed_repos = []

[workspace]
enabled = true
root = "~/.local/state/forge-bot/workspaces"
reuse = true
git_author_name = "forge-bot"
git_author_email = "forge-bot@localhost"

[reply]
# Post "on it" as soon as the mention is accepted, so a busy or slow agent
# does not leave the thread unanswered.
ack = true
result = true

[session]
dir = "~/.local/state/forge-bot/state"
# Concurrent agent runs across every adapter. This is the single total count
# of agents; there is no separate per-adapter or pool limit. A slot covers the
# whole job (checkout, run and reply), so this also caps workspace preparation;
# one conversation runs at most one agent, so it also caps parallel
# conversations.
workers = 16
queue_capacity = 256
recover = true

[agents.codex]
timeout_secs = 1800
# dangerously_skip_permissions = false

[pi_rpc]
command = "pi"
idle_ttl_secs = 900
timeout_secs = 1800
approve = true
# Persist the backend session so an evicted process resumes the conversation.
no_session = false
# Start a new session for a new conversation (default). Set to false to reuse
# an idle process across conversations in the workspace.
session_per_conversation = true
# model = "deepseek-flash"
# provider = "deepseek"

# The one-shot `pi` adapter is disabled by default now that `pi-rpc` is the
# default Pi backend. Uncomment to bring it back.
# [agents.pi]
# enabled = true

[poller]
enabled = false
interval_secs = 15
repositories = []
discover_interval_secs = 300
lookback_secs = 3600
