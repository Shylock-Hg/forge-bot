# Example configuration for a per-user forge-bot install.
#
# `~` is expanded against $HOME. State and workspaces live under the user's
# home so the service can never reach system-wide state or another account.

bind = "127.0.0.1:8080"
mention = "@agent"
default_agent = "pi-rpc"

[forgejo]
base_url = "http://127.0.0.1:3000"
# webhook_secret = "change-me"
# token = "change-me"
bot_username = "forge-bot"

[policy]
allowed_users = ["admin"]
allowed_repos = []

[workspace]
enabled = true
root = "~/.local/state/forge-bot/workspaces"
reuse = true
git_author_name = "forge-bot"
git_author_email = "forge-bot@localhost"

[reply]
ack = false
result = true

[session]
dir = "~/.local/state/forge-bot/state"
workers = 2
queue_capacity = 256
recover = true

[agents.codex]
timeout_secs = 1800
# dangerously_skip_permissions = false

[pi_rpc]
command = "pi"
max_agents = 2
idle_ttl_secs = 900
timeout_secs = 1800
approve = true
no_session = true
# model = "deepseek-flash"
# provider = "deepseek"

[poller]
enabled = false
interval_secs = 15
repositories = []
discover_interval_secs = 300
lookback_secs = 3600
